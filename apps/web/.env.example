# ---- API (apps/api/.env) ----
PORT=4000
NODE_ENV=development
# Leave MONGODB_URI empty for local dev: the API then uses a persistent
# JSON file store at apps/api/data/dev.json (same repository layer).
# For production set your MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizsphere
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
SEED_ON_BOOT=true
# ---- Web (apps/web/.env) ----
# Browser calls use relative /api URLs (Vite proxy in dev, Vercel rewrite in prod).
# Only set this if your deployment cannot proxy /api:
VITE_API_URL=
