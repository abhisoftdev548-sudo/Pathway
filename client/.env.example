# ── QuizSphere client environment ─────────────────────────────────────────────
# Copy to .env.local. Never put secrets here — Vite exposes these to the browser.

# Base URL of the QuizSphere API (include /api/v1).
# Leave as-is for local dev: Vite proxies /api to the server.
VITE_API_URL=/api/v1

# When running the client against a separately hosted API (e.g. Render),
# set the full public URL instead:
# VITE_API_URL=https://quizsphere-api.onrender.com/api/v1
