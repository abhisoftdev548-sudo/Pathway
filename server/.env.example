# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB Atlas connection string (local MongoDB works for development).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pathforge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pathforge

# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Cookies: use SameSite=None + Secure when the frontend and API are on different sites
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

# Initial administrator created by `npm run seed`
# These match the credentials shown on the login page.
SEED_ADMIN_NAME=PathForge Admin
SEED_ADMIN_EMAIL=admin@pathforge.local
SEED_ADMIN_PASSWORD=Admin_PathForge_123!

# Demo learner created by `npm run seed` (omit with --no-demo)
SEED_DEMO_NAME=Demo Learner
SEED_DEMO_EMAIL=demo@pathforge.dev
SEED_DEMO_PASSWORD=Demo_PathForge_123!

# Password reset links (frontend route used in emails/dev responses)
APP_URL=http://localhost:5173
TRUST_PROXY=1

# Optional: directory of the built React app. In production the API serves it
# from this path when index.html is present (defaults to ../client/dist).
# CLIENT_DIST=/app/client/dist
