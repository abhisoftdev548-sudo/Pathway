# ── QuizSphere server environment ─────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit real credentials.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongodb:// / FerretDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/quizsphere

# Auth secrets — use long random strings (e.g. `openssl rand -hex 48`)
ACCESS_TOKEN_SECRET=change-me-access-secret-min-32-chars
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# CORS — explicit allowlist, comma separated (no trailing spaces)
CORS_ORIGINS=http://localhost:5173

# Cookies
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin used to build password-reset links in emails/notifications
CLIENT_URL=http://localhost:5173

# Cloudinary (optional — image features are disabled gracefully when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20

# Password reset token lifetime (minutes)
PASSWORD_RESET_TTL_MINUTES=30

# Optional: platform bootstrap — first registered user becomes admin when true
BOOTSTRAP_FIRST_ADMIN=false
